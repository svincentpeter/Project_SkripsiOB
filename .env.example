# ==========================================
# OMAH BAN CABANG 3 - ENVIRONMENT VARIABLES
# ==========================================

# SUPABASE CLOUD DATABASE (PostgreSQL)
# Dapatkan kredensial ini di Dashboard Supabase > Project Settings > API
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"

# OPTIONAL: Laravel 12 Backend API (Jika running hybrid lokal dengan PHP)
VITE_API_URL="http://127.0.0.1:8000/api/v1"

# GEMINI AI API KEY (Opsional untuk fitur asisten cerdas)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL
APP_URL="http://localhost:3000"
